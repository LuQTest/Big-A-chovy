# Optional proxy for requests made from inside the container.
# Docker Desktop exposes the host as host.docker.internal.
# Leave blank when the container can reach the market data endpoints directly.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Host port and timezone for docker-compose.
DASHBOARD_PORT=8765
TZ=Asia/Shanghai

# Version check (the only outbound request the app makes).
# It sends no local data. Set to "off" to disable it entirely.
A_SHARE_UPDATE_CHECK=on
# Version to report inside the container; leave blank to read the repo VERSION file.
# Only needed when you build an image from a checkout rather than pulling a tagged one.
A_SHARE_VERSION=
# How this container gets upgraded, which decides the command the UI suggests:
# auto (inspect the shipped docker-compose.yml) | image | build | run
A_SHARE_DOCKER_MODE=auto
